# environments
.venv/
__pycache__/
*.py[cod]

# model weights - never commit these (see README for official sources)
ckpts/
models/
*.pt
*.pth
*.onnx

# input footage and everything the pipeline generates
data/input/*
!data/input/.gitkeep
outputs/*
# Hand labelling is expensive and irreplaceable, and the evaluation derived from it is the
# only accuracy record. Everything else under outputs/ is regenerable; these two are not.
!outputs/*/
outputs/*/*
!outputs/*/ground_truth.json
!outputs/*/truth.json
!outputs/*/baseline.json
!outputs/*/evaluation.json
# Milestone 2 keeps its labelling one level deeper. Same reasoning: the shot labels cost hours
# of frame-by-frame review and cannot be regenerated, and the evaluation is the only record of
# what was measured against them.
!outputs/*/shots/
outputs/*/shots/*
!outputs/*/shots/ground_truth.json
!outputs/*/shots/evaluation.json
!outputs/*/shots/taxonomy.json

# media, wherever it lands
*.mp4
*.mov
*.avi
*.mkv

# WSL / Windows cruft
*:Zone.Identifier
.DS_Store
egg-info/
*.egg-info/

# Screening configs for downloaded reference clips are generated, not authored.
configs/*.screen.json
